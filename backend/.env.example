# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=job_tracker_db

# JWT Secret Key
SECRET_KEY=generate-your-own-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings
APP_NAME=Job Application Tracker
DEBUG=True

# AI / NLP Configuration (all optional — defaults are set in config.py)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# SPACY_MODEL=en_core_web_sm
# RANKING_MODEL_VERSION=hybrid-baseline-v1
