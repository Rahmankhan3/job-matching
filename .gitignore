# Root-level .gitignore for entire job-tracker project

# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
*.eggs
.eggs/
dist/
build/
*.manifest
*.spec
.env
env/
venv/
.venv/
python-env/

# Byte-compiled / optimized / DLL files
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
scripts/
src/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pyproject
*.egg-info/

overlays/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# VSCode settings
.vscode/

# macOS
.DS_Store

# Node.js / frontend assets
node_modules/
dist/
build/

# logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Local env files
.env
*.env

# IDEs and editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Additional
frontend/dist
frontend/node_modules

# Ignore generated python bytecode anywhere
__pycache__
*.py[cod]

# Ignore secrets and configs
secrets.json

# Dataset directories
resume_data/
data/
backend/data/
backend/app/uploads/resumes/*
!backend/app/uploads/resumes/.gitkeep
backend/app/uploads/logos/*
!backend/app/uploads/logos/.gitkeep

